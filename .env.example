# === Armance Provider Configuration ===
# Copy this file to .armance/.env and fill in your API keys.
# Or set environment variables directly (takes precedence).

# OpenRouter (default) — https://openrouter.ai
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini — https://ai.google.dev
# GEMINI_API_KEY=AIza...
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Anthropic Claude Code
# CLAUDE_CODE_API_KEY=sk-ant-...

# Custom OpenAI-compatible endpoint
# CUSTOM_OPENAI_API_KEY=sk-...
# CUSTOM_OPENAI_BASE_URL=https://your-custom-endpoint/v1
