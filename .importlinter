[importlinter]
root_package = armance
include_external_packages = True

[importlinter:contract:layers]
name = Layered Architecture
type = layers
layers =
    armance.client
    armance.transport
    armance.service
    armance.core

[importlinter:contract:service-limits]
name = Service layer limits
type = forbidden
source_modules = armance.service
forbidden_modules =
    armance.transport
    armance.client

[importlinter:contract:core-is-pure]
name = Core is pure
type = forbidden
source_modules = armance.core
forbidden_modules =
    armance.service
    armance.transport
    armance.client
    armance.providers
    armance.storage

[importlinter:contract:providers-limits]
name = Providers limits
type = forbidden
source_modules = armance.providers
forbidden_modules =
    armance.service
    armance.transport
    armance.client
    armance.storage
# Documented debt: exchange-log + ledger helpers live in service.llm_service
# and are lazily imported by the openrouter client for request logging.
# Queued: move log_request/log_response/get_ledger below the provider layer.
ignore_imports =
    armance.providers.openrouter -> armance.service.llm_service

[importlinter:contract:storage-limits]
name = Storage limits
type = forbidden
source_modules = armance.storage
forbidden_modules =
    armance.service
    armance.transport
    armance.client
    armance.providers

[importlinter:contract:platform-limits]
name = Platform limits (J.0)
type = forbidden
source_modules = armance.platform
forbidden_modules =
    armance.service
    armance.client
